# Copy to migration.env (same directory), fill in values, then:
#   set -a && source scripts/supabase/migration.env && set +a   # bash
# Do NOT commit migration.env — it contains secrets.

# --- Database (Dashboard → Connect → Session pooler or direct URI) ---
# Old project (source)
SOURCE_SUPABASE_DB_URL=postgresql://postgres.[OLD_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# New project (target region)
TARGET_SUPABASE_DB_URL=postgresql://postgres.[NEW_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Optional: pgsodium root key copy (column encryption) — scripts/supabase/copy-pgsodium-root-key.sh ---
# OLD_PROJECT_REF=your_old_ref
# NEW_PROJECT_REF=your_new_ref
# SUPABASE_ACCESS_TOKEN=your_personal_access_token

# --- App cutover verification (optional, for verify-cutover.mjs) ---
# NEXT_PUBLIC_SUPABASE_URL=https://NEW_REF.supabase.co
# SUPABASE_PROJECT_ID=NEW_REF

# Workflow (from repo root, after copying this file to migration.env):
#   pnpm supabase:migrate:check
#   pnpm supabase:migrate:dump
#   pnpm supabase:migrate:restore -- scripts/supabase/artifacts/<timestamp>
#   pnpm supabase:migrate:post-db

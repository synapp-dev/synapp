{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "supabase:migrate:check": "bash scripts/supabase/check-prereqs.sh",
    "supabase:migrate:dump": "bash scripts/supabase/dump-database.sh",
    "supabase:migrate:restore": "bash scripts/supabase/restore-database.sh",
    "supabase:migrate:post-db": "bash scripts/supabase/print-post-database-steps.sh",
    "supabase:migrate:dump-history": "bash scripts/supabase/dump-migration-history.sh",
    "supabase:migrate:restore-history": "bash scripts/supabase/restore-migration-history.sh",
    "supabase:migrate:pgsodium": "bash scripts/supabase/copy-pgsodium-root-key.sh",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:architecture": "eslint --no-inline-config -c eslint.architecture.mjs apps packages",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@typescript-eslint/parser": "^8.24.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "supabase": "^2.31.4",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "react-countup": "^6.5.3",
    "zod": "^4.0.5"
  },
  "pnpm": {
    "overrides": {
      "google-auth-library": "^10.7.0",
      "axios": ">=1.12.0",
      "esbuild": ">=0.25.0",
      "@babel/runtime-corejs3": ">=7.26.10",
      "js-yaml": ">=4.1.1",
      "brace-expansion": ">=1.1.12",
      "@eslint/plugin-kit": ">=0.3.4",
      "tmp": ">=0.2.4"
    }
  }
}

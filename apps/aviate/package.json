  "type": "module",
  "private": true,
  "description": "Aviate — all-in-one aviation workforce management (rostering, leave, payslips, team comms)",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 next dev -p 3008 --turbopack",

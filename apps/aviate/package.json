    "@workspace/supabase": "workspace:*",
    "@workspace/ui": "workspace:*",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.0.12",
    "lucide-react": "^0.575.0",
    "next": "^15.4.7",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",

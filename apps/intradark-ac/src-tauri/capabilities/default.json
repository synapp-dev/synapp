{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core + deep-link + scoped HTTP permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3004/*" },
        { "url": "https://intradark.com/*" }
      ]
    }
  ]
}

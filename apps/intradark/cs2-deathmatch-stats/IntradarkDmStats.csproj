<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required for CounterStrikeSharp to load the plugin + its non-runtime deps. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>IntradarkDmStats</AssemblyName>
    <RootNamespace>IntradarkDmStats</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the CounterStrikeSharp runtime; don't ship it with the plugin.
         Bump the version to match the CSS build installed on your server. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.305">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Local durable buffer. Copied alongside the plugin (EnableDynamicLoading). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>

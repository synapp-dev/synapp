{
  "name": "intradark",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Intradark",
  "scripts": {
    "dev": "next dev -p 3004 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen-types": "node ../../scripts/supabase/gen-types.mjs",

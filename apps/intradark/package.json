    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.16",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.0.12",
    "lucide-react": "^0.575.0",
    "next": "^15.4.7",
    "next-themes": "^0.4.4",

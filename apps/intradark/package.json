    "seed:mirage-lineups": "tsx scripts/seed-mirage-lineups.ts",
    "seed:dust2-lineups": "dotenv -e .env.local -- tsx scripts/seed-dust2-lineups.ts",
    "storage:raw-upload-test": "dotenv -e .env.local -- tsx scripts/storage-raw-upload-test.ts",
    "generate:dust2-lineups-sql": "tsx scripts/generate-dust2-lineups-sql.ts",
    "discord-bot": "dotenv -e .env.local -- tsx discord-bot/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.5",

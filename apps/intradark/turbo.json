{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_*",
        "POSTGRES_*",
        "SUPABASE_*",
        "DATABASE_URL",
        "DATABASE_URL_POOLER",
        "ANTHROPIC_API_KEY",
        "CRON_SECRET",
        "NEWS_BOT_USER_ID",
        "REDLINE_*",
        "NODE_ENV",
        "AC_*",
        "CS2_*",
        "DISCORD_*",
        "STEAM_*",
        "FACEIT_API_KEY",
        "LEGITIMACY_SCORING_ENABLED"
      ]
    }
  }
}

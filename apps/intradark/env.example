# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key
SUPABASE_ADMIN_KEY=your_supabase_service_role_key
# Required for: pnpm gen-types, pnpm verify:supabase-cutover
SUPABASE_PROJECT_ID=your_project_ref

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Database Configuration
# For Supabase, this is the Postgres connection string from your Supabase dashboard
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Or direct connection: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Get this from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=your_database_url

# Other Configuration
NODE_ENV=development

# App Configuration (use the port your dev server runs on, e.g. 3004 for intradark)
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Vercel Web Analytics: `@vercel/analytics` is wired in `app/layout.tsx`. Enable collection in the Vercel project → Analytics (no env vars required for defaults).

# Staff sandbox: `/admin/sandbox/*` — grant `sandbox.access` in `public.user_roles` using **`user_profiles.id`** (see docs/features/admin-panel).

# Steam Configuration
STEAM_API_KEY=your_steam_api_key

# Discord OAuth (link account — register redirect URI in Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Discord bot (practice: lobby → team voice automove) — long-lived process: pnpm discord-bot
# Same Discord application as OAuth: enable a Bot user, copy Bot Token (not the OAuth client secret).
# Developer Portal → Bot → enable intents: Server Members only if needed later; Guild Voice States is required for voice moves (enable under Privileged Gateway Intents if listed).
# Invite URL (replace CLIENT_ID). MUST include applications.commands or slash registration returns 50001 Missing Access:
# https://discord.com/api/oauth2/authorize?client_id=CLIENT_ID&permissions=17827832&scope=bot%20applications.commands
# Developer Portal → OAuth2 → URL Generator: enable scopes "bot" AND "applications.commands", then open the generated URL and authorize again (re-add bot to the server).
# permissions=17827832 = View Channel + Connect + Move Members + Manage Channels
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_server_guild_id
# Permanent lobby voice channel (snowflake id); players join here first
DISCORD_LOBBY_VOICE_CHANNEL_ID=your_lobby_voice_channel_id
# Category for match team voice channels (snowflake). Match channels are ordered just below
# DISCORD_LOBBY_VOICE_CHANNEL_ID; the lobby VC must be in this same category.
# DISCORD_MATCH_CATEGORY_ID=your_match_category_snowflake
# Comma-separated Discord user snowflakes for mock roster (practice only)
DISCORD_PRACTICE_TEAM_A_IDS=
DISCORD_PRACTICE_TEAM_B_IDS=
# Optional: comma-separated user ids allowed to run /pug-practice-start and /pug-practice-end (omit = any guild member can run)
# DISCORD_BOT_ADMIN_USER_IDS=

# Bot HTTP control API (match sandbox in Next.js calls this — bind localhost only)
# Use the same DISCORD_BOT_HTTP_SECRET in .env.local for both `pnpm discord-bot` and `pnpm dev`.
DISCORD_BOT_HTTP_SECRET=generate_a_long_random_string
# DISCORD_BOT_HTTP_PORT=3847
# Optional override when proxying (default http://127.0.0.1:3847)
# DISCORD_BOT_HTTP_URL=http://127.0.0.1:3847
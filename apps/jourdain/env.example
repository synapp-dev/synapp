# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Any one of the following (same value as Project API "anon" / publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=          # classic dashboard name
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required for: pnpm gen-types, pnpm verify:supabase-cutover
SUPABASE_PROJECT_ID=your_project_ref

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3007
NEXTAUTH_SECRET=your_nextauth_secret

# Database Configuration (if using external database)
DATABASE_URL=your_database_url

# Anthropic (required for the /agent chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google integration — Calendar + Gmail (read-only) via one OAuth client.
# Enable the Google Calendar API and Gmail API in the Cloud Console project and
# add the calendar + gmail.readonly scopes to the OAuth consent screen.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Web Push (PWA notifications)
# Generate a keypair: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
# Shared secret protecting /api/push/run-reminders. Vercel Cron sends it as a
# Bearer token automatically when set as a project env var.
CRON_SECRET=your_cron_secret

# Other Configuration
NODE_ENV=development 
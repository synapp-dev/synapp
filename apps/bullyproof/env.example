# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key
SUPABASE_ADMIN_KEY=your_supabase_service_role_key
# Optional explicit JWKS URL; if omitted, it's derived from NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Configuration
# Add any additional secrets if used, otherwise these may be omitted
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your_nextauth_secret

# Database Configuration (if using external database)
# DATABASE_URL=your_database_url

# Other Configuration
NODE_ENV=development
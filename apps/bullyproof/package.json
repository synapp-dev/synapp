    "react-timeago": "^8.3.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.6",
    "tsparticles": "^3.9.1",
    "tsparticles-slim": "^2.12.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.0.0",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",

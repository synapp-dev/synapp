{
  "name": "bullyproof",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Bullyproof",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 next dev -p 3000 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen-types": "node ../../scripts/supabase/gen-types.mjs",
    "verify:supabase-cutover": "node ../../scripts/supabase/verify-cutover.mjs",
    "supabase-start": "npx supabase start",
    "seed:reference": "tsx scripts/seed-reference-data.ts",
    "migrate:schools": "tsx scripts/migrate-schools.ts",
    "test:migration": "tsx scripts/test-migration.ts",
    "generate:sql": "tsx scripts/generate-sql.ts",
    "fix:schema": "tsx scripts/fix-drizzle-schema.ts",
    "pull-and-fix-schema": "tsx scripts/pull-and-fix-schema.ts",
    "fix:certification-order": "tsx scripts/fix-certification-topic-order.ts",
    "migrate:slide-paths": "tsx scripts/migrate-slide-storage-paths.ts",
    "migrate:slide-paths-remote": "tsx scripts/invoke-migrate-edge-function.ts",
    "rollback:slide-paths": "tsx scripts/rollback-slide-storage-paths.ts",
    "backfill:slide-positions": "tsx scripts/backfill-slide-positions.ts",
    "flowchart:lesson": "mmdc -i misc/lesson-flow-comprehensive.mmd -o misc/lesson-flow-comprehensive.png",
    "docs:code-reference:inventory": "tsx scripts/generate-code-reference-inventory.ts write",
    "docs:code-reference:generate": "tsx scripts/generate-code-reference-inventory.ts write+markdown",
    "docs:code-reference:check": "tsx scripts/generate-code-reference-inventory.ts check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },

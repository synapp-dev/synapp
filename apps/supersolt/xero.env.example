# Xero (accounting / supplier invoices) — copy into .env.local as needed.
# OAuth tokens belong in your database, not here.
# Requires migrations:
#   supabase/migrations/20260520120000_venue_xero_connections.sql
#   supabase/migrations/20260522120000_venue_xero_invoices.sql

XERO_CLIENT_ID=
# Server-only; never expose to the browser
XERO_CLIENT_SECRET=
# Must exactly match a redirect URL registered in the Xero developer app
# Supersolt dev defaults to port 3005: http://localhost:3005/api/xero/oauth/callback
XERO_OAUTH_REDIRECT_URI=http://localhost:3005/api/xero/oauth/callback
# OAuth scopes are hardcoded in server/xero/config.ts for supplier-invoice ingestion:
#   accounting.invoices, accounting.attachments, accounting.contacts, accounting.settings
# Enable those four in developer.xero.com → Configuration (do not add app.connections to the auth URL).
# Optional: dedicated HMAC secret for OAuth state cookie (defaults to XERO_CLIENT_SECRET)
# XERO_OAUTH_STATE_SECRET=
# Dev only: mock Xero PayRun push/finalise without payroll API scopes
# XERO_PAYROLL_MOCK=1
# HMAC key for Xero payroll webhook signature verification
# XERO_PAYROLL_WEBHOOK_KEY=

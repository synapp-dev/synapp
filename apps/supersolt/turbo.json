{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_*",
        "SUPABASE_*",
        "POSTGRES_*",
        "DATABASE_URL",
        "DATABASE_URL_POOLER",
        "NEXT_PUBLIC_APP_URL",
        "CRON_SECRET",
        "ANTHROPIC_API_KEY",
        "SQUARE_*",
        "XERO_*",
        "POSTMARK_*",
        "PO_EMAIL_FROM_OVERRIDE",
        "WEATHER_FORECAST_ENABLED",
        "INVOICE_PARSE_CONCURRENCY"
      ]
    }
  }
}

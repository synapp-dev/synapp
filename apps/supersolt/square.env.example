# Square (POS / Catalog / Orders) — copy into .env.local as needed.
# Square’s Node OAuth sample (authorize URL shape, sandbox dashboard step): https://github.com/square/connect-api-examples/tree/master/connect-examples/oauth/node
# OAuth tokens (access_token, refresh_token, merchant_id) belong in your database, not here.

# sandbox | production — authorize/token use https://connect.squareupsandbox.com or https://connect.squareup.com
SQUARE_ENVIRONMENT=sandbox
# Sandbox OAuth: sign in via Developer Console → Sandbox test accounts → Open in Square Dashboard first,
# then start Connect from this app (see https://developer.squareup.com/docs/oauth-api/walkthrough ).

# --- Option A: server-side sandbox testing (no per-merchant OAuth) ---
# Developer Console → your application → Credentials (Sandbox toggle)
SQUARE_ACCESS_TOKEN=

# --- Option B: OAuth (each merchant authorizes your app) ---
# Developer Console → OAuth (Sandbox toggle)
SQUARE_APPLICATION_ID=
# Server-only; never expose to the browser
SQUARE_APPLICATION_SECRET=
# Must exactly match a redirect URL registered for the app (Sandbox allows http://localhost:...)
# Supersolt dev defaults to port 3005: http://localhost:3005/api/square/oauth/callback
#
# Use the SAME host when you open the app in the browser: if this is localhost, don’t use 127.0.0.1
# (the OAuth cookie won’t be sent back on callback). Trailing slashes must match the console.
SQUARE_OAUTH_REDIRECT_URI=http://localhost:3005/api/square/oauth/callback

# Optional: HMAC secret for OAuth state (CSRF). If unset, SQUARE_APPLICATION_SECRET is used.
# SQUARE_OAUTH_STATE_SECRET=

# Scopes (space-separated). Default = all Square OAuthPermission *_READ scopes (see server/square/config.ts).
# After changing scopes, disconnect/reconnect Square (or revoke in Dashboard) and authorize again.
# Override if authorize returns invalid_scope (try removing beta: VENDOR_READ, PAYOUTS_READ, DEVICES_READ).
# SQUARE_OAUTH_SCOPES=MERCHANT_PROFILE_READ PAYMENTS_READ ORDERS_READ

# For venue staff who are not org admins: server routes read OAuth tokens with the service role.
# Add to .env.local (never commit): SUPABASE_SERVICE_ROLE_KEY=...

# --- Optional: default Square location id written on OAuth callback for EVERY venue ---
# Leave empty in production multi-tenant: a wrong id causes "Not authorized to list payments for location_id".
# If set, it overrides any stored venue location each time someone completes Connect Square.
SQUARE_LOCATION_ID=

# --- Optional: verify webhook payloads (set when you configure webhooks) ---
# SQUARE_WEBHOOK_SIGNATURE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# JWT verification uses Supabase Auth JWKS (derived from NEXT_PUBLIC_SUPABASE_URL).
# No manual JWT secret is required for Drizzle RLS. Optional override:
# NEXT_PUBLIC_SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Auth email links (signup confirm, password reset). Dev: http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Dev only: unlock all inventory setup sections (ignores phase1/phase2 locks)
# NEXT_PUBLIC_INVENTORY_SETUP_UNLOCK_ALL=true
# Optional: project ref for tooling (gen-types if you add it)
# SUPABASE_PROJECT_ID=
# Xero (supplier invoices): see xero.env.example
# OPENAI_API_KEY=  # invoice PDF/image parsing
# POSTMARK_INBOUND_WEBHOOK_SECRET=
# CRON_SECRET=
# Required by drizzle-kit pull/introspect scripts
DATABASE_URL=
# Optional: service-role / bypass connection for admin Drizzle (forecast sync, OAuth token storage)
# DATABASE_URL_ADMIN=

# Local-only: server admin routes (forecast sync, Square tokens). Prefer SUPABASE_ADMIN_KEY.
# SUPABASE_ADMIN_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional shared password for demo accounts (default in script if unset)
# DEMO_USER_PASSWORD=

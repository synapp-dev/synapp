NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# JWT verification uses Supabase Auth JWKS (derived from NEXT_PUBLIC_SUPABASE_URL).
# No manual JWT secret is required for Drizzle RLS. Optional override:
# NEXT_PUBLIC_SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Auth email links (signup confirm, password reset). Dev: http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Dev only: unlock all inventory setup sections (ignores phase1/phase2 locks)
# NEXT_PUBLIC_INVENTORY_SETUP_UNLOCK_ALL=true
# Unlock Phase 2 modules (Workforce, Operations, Insights P&L): sidebar, routes, agent nav
# NEXT_PUBLIC_PHASE2_MODULES=true
# Optional: project ref for tooling (gen-types if you add it)
# SUPABASE_PROJECT_ID=
# Xero (supplier invoices): see xero.env.example
# ANTHROPIC_API_KEY=  # AI features (agent chat, invoice parsing, superbot)
# POSTMARK_INBOUND_WEBHOOK_SECRET=
# Outbound PO emails (Postmark server token; unset = record-only, nothing sends)
# POSTMARK_SERVER_TOKEN=
# Dev only: verified From address override while inbox.supersolt.com is unverified
# PO_EMAIL_FROM_OVERRIDE=
# CRON_SECRET=
# Weather-aware forecasting (Open-Meteo, no key needed). Off unless exactly "true":
# gates the daily weather sync cron AND the forecast weatherMultiplier.
# WEATHER_FORECAST_ENABLED=true
# Required by drizzle-kit pull/introspect scripts
DATABASE_URL=
# Optional: service-role / bypass connection for admin Drizzle (forecast sync, OAuth token storage)
# DATABASE_URL_ADMIN=

# Local-only: server admin routes (forecast sync, Square tokens). Prefer SUPABASE_ADMIN_KEY.
# SUPABASE_ADMIN_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional shared password for demo accounts (default in script if unset)
# DEMO_USER_PASSWORD=
# Test-run onboarding: orgs created with "This is a test run" mirror this venue's
# Square + Xero connections instead of real OAuth. Requires the
# test_mode_mirror_connections migration. Unset = feature fully off.
# TEST_MODE_SOURCE_VENUE_ID=

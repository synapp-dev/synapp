{
  "name": "supersolt",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Supersolt starter foundation",
  "scripts": {
    "dev": "next dev -p 3005 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "drizzle:pull": "drizzle-kit pull && pnpm fix:schema",
    "fix:schema": "tsx scripts/fix-drizzle-schema.ts",
    "pull-and-fix-schema": "drizzle-kit pull && pnpm fix:schema",
    "seed:demo-people": "tsx scripts/seed-demo-people.ts",
    "seed:richmond-april-weeks": "tsx scripts/seed-richmond-april-2026-week-availability.ts",
    "backfill:square-sales-mirror": "tsx scripts/backfill-square-sales-mirror.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/react": "^3.0.179",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.51.0",
    "@tanstack/react-query": "^5.83.0",
    "@workspace/ui": "workspace:*",
    "ai": "^6.0.177",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.44.3",
    "jose": "^6.0.12",
    "lucide-react": "^0.575.0",
    "next": "^15.4.7",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
